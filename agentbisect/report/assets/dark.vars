--bg: #0b0e14; --bg2: #10141c; --panel: #151a23; --panel2: #1b212c; --ink: #e8ebf2;
--muted: #9aa5b8; --line: #262d3a; --line2: #364052;
--accent: #8f84ff; --accent-bg: #211f46; --accent-ink: #0b0e14;
--red: #ff6b78; --red-bg: #34171c; --red-solid: #e5484d;
--amber: #f2b45a; --amber-bg: #33270f;
--blue: #6aa8ff; --blue-bg: #13253f;
--green: #55d089; --green-bg: #11301f;
--code-bg: #0d1118; --code-ink: #d7deea;
--add-bg: #11301f; --add-ink: #9be6b6; --add-gut: #17432a;
--del-bg: #34171c; --del-ink: #ffadb4; --del-gut: #4b2027;
--hunk-bg: #13253f; --hunk-ink: #8fbaff;
--tk-k: #c792ea; --tk-s: #a5d6a7; --tk-c: #7d8aa0; --tk-n: #f2b45a;
--shadow: 0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.25);
--hero: linear-gradient(135deg, #1b1740 0%, #151a23 55%);
color-scheme: dark;
