{% extends "shell.html.j2" %}
{% block noscript %}
<style>#app { display: none; }</style>
<main style="max-width: 980px; margin: 0 auto; padding: 16px; font-family: system-ui, sans-serif;">
  <h1>AgentBisect study</h1>
  <p>git bisect for coding agents. This page is interactive and needs JavaScript; the numbers are below as plain text.</p>
  <p>{{ created }}{% if design %} &middot; {{ design }}{% endif %}</p>

  <h2>Scope</h2>
  <p>{{ scope }}</p>
  <p>{{ counts.runs }} run{{ '' if counts.runs == 1 else 's' }} counted,
     {{ counts.broken_runs }} ended broken{% if excluded %}, {{ excluded|length }} excluded{% endif %}.</p>

  {% if featured %}
  <h2>Demo runs</h2>
  <ul>
    {% for f in featured %}
    <li><a href="{{ f.href }}">{{ f.run_id }}</a>: {{ f.sentences|join(' ') }}</li>
    {% endfor %}
  </ul>
  {% endif %}

  <h2>Try it on your own repo</h2>
  <p>AgentBisect runs on your machine. The command builder here needs JavaScript. Without it, follow "Use it on your own project" in the README: <code>agentbisect record --repo ... --prompt-file ...</code>, then <code>agentbisect run --trace runs/&lt;run-folder&gt;</code> and <code>agentbisect report --trace runs/&lt;run-folder&gt;</code>.</p>

  <h2>Headline numbers</h2>
  {% if metrics %}
  <ul>
    {% for m in metrics %}
    <li><strong>{{ m.name }}</strong>: {{ m.value }}{% if m.interval %} ({{ m.interval }}){% endif %},
      n = {{ m.n }}, {{ m.method }}{% if m.note %}. {{ m.note }}{% endif %}{% if m.simulation %} (simulation, not real agent runs){% endif %}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No metrics were computed.</p>
  {% endif %}

  <h2>Detection lag in broken runs</h2>
  {% if lag_chart %}
  <ul>{% for b in lag_chart.bars %}<li>{{ b.title }}</li>{% endfor %}</ul>
  {% else %}
  <p>No run ended broken with a decisive step, so there is nothing to draw.</p>
  {% endif %}

  <h2>Repaired breaks (a separate series)</h2>
  <p>The agent broke a test that passed at the start, saw the failure, and fixed it. We find these only when the agent saw them, so none is censored. They say nothing about breaks the agent never saw. Never pool this series with the broken runs above.</p>
  {% if episodes %}
  <table>
    <thead><tr><th>Run</th><th>Test</th><th>Seen at</th><th>t_err</th><th>Lag</th><th>Tokens wasted</th><th>Note</th></tr></thead>
    <tbody>
    {% for e in episodes %}
    <tr><td>{% if e.href %}<a href="{{ e.href }}">{{ e.run_id }}</a>{% else %}{{ e.run_id }}{% endif %}</td>
      <td>{{ e.check }}</td><td>{{ e.seen_at }}</td><td>{{ e.t_err }}</td><td>{{ e.lag }}</td><td>{{ e.wasted }}</td><td>{{ e.reason or '' }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No repaired breaks found.</p>
  {% endif %}

  <h2>Runs</h2>
  {% if runs %}
  <table>
    <thead><tr><th>Task</th><th>Run</th><th>Test</th><th>Steps</th><th>Broken?</th><th>t_err</th><th>t_obs</th><th>Lag</th><th>Wasted share</th><th>Sabotage correct</th></tr></thead>
    <tbody>
    {% for r in runs %}
    <tr><td>{{ r.task }}</td>
      <td>{% if r.href %}<a href="{{ r.href }}">{{ r.run_id }}</a>{% else %}{{ r.run_id }}{% endif %}</td>
      <td>{{ r.check }}</td><td>{{ r.steps }}</td><td>{{ r.broken }}</td><td>{{ r.t_err }}</td><td>{{ r.t_obs }}</td>
      <td>{{ r.lag }}</td><td>{{ r.share }}</td><td>{{ r.sabotage }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No runs.</p>
  {% endif %}

  <h2>Excluded runs</h2>
  {% if excluded %}
  <ul>{% for rid, reason in excluded %}<li>{{ rid }}: {{ reason }}</li>{% endfor %}</ul>
  {% else %}
  <p>No run was excluded.</p>
  {% endif %}

  <h2>What this can and cannot claim</h2>
  <h3>It can claim</h3>
  <ul>{% for s in can_claim %}<li>{{ s }}</li>{% endfor %}</ul>
  <h3>It cannot claim</h3>
  <ul>{% for s in cannot_claim %}<li>{{ s }}</li>{% endfor %}</ul>
</main>
{% endblock %}
